{
  "name": "jovi-app",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "css": "npx @tailwindcss/cli -i ./src/input.css -o ./dist/output.css --watch",
    "serve": "npx live-server --port=5500 --no-browser",
    "dev": "concurrently \"npm run css\" \"npm run serve\"",
    "build": "npx @tailwindcss/cli -i ./src/input.css -o ./dist/output.css --minify && npx esbuild src/js/main.js --bundle --minify --outfile=dist/bundle.js"
  },
  "repository": {
    "type": "git",
    "url": "git@github-personal:AlexIshikawa/jovi-app.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "concurrently": "^10.0.5",
    "live-server": "^1.2.2",
    "tailwindcss": "^4.3.3"
  }
}